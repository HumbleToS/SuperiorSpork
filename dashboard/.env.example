# Copy to .env (mode 600). Every variable the dashboard reads; nothing here reaches a client bundle.

# Public origin of the dashboard. The OAuth redirect URI is {APP_URL}/api/auth/callback/discord.
APP_URL=https://sprok.umbleh.dev

# Discord application (Developer Portal → OAuth2). Same application as the bot.
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace-me

# 32 random bytes for the session cookie's encryption key, base64url or hex. Rotating it signs everyone out.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SESSION_SECRET=replace-me-with-43-plus-chars-of-base64url

# The bot's internal API on the private Docker network, and the shared token (API_TOKEN in the bot's config.py).
BOT_API_URL=http://superiorspork:8080/internal/v1
BOT_API_TOKEN=replace-me

# Only "true" once Traefik trusts Cloudflare's IP ranges for forwarded headers; otherwise the header can be spoofed.
TRUST_CF_CONNECTING_IP=false

# Hostnames that serve only the legal pages (rewritten in src/proxy.ts).
PRIVACY_HOST=privacy.sprok.umbleh.dev
TERMS_HOST=terms.sprok.umbleh.dev

# Keeps Server Action references decryptable across rebuilds (optional; any 32-byte base64 string).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
